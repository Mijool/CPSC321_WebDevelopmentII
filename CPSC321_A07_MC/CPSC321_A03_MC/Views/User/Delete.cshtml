@model CPSC321_A07_MC.Models.UserModel

@{
	ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
	<h4>UserModel</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.ID)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.ID)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.FirstName)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.FirstName)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.LastName)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.LastName)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Department)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Department)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Position)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Position)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.YearsOfExperience)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.YearsOfExperience)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Salary)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Salary)
		</dd>
	</dl>
	

    
	<form asp-action="Delete">
		<div>
			@*to be able to provide a regex check when we enter our data, we need to secretly submit all existing employee data
				so that the modelState returns valid.
				I do this by hiding the inputs that are preloaded when the view is generated*@
			<input type="hidden" asp-for="ID" class="form-control" />
			<input type="hidden" asp-for="FirstName" class="form-control" />
			<input type="hidden" asp-for="LastName" class="form-control" />
			<input type="hidden" asp-for="Department" class="form-control" />
			<input type="hidden" asp-for="Position" class="form-control" />
			<input type="hidden" name="Salary" value="@Model.Salary" />
			@*asp-for formats salary so we must submit the exact value from the model*@
			<input type="hidden" asp-for="YearsOfExperience" class="form-control" />
		</div>

		<h2>Please enter your reason for deletion</h2>
		<input asp-for="DeletionComment" class="form-control" />
		<span asp-validation-for="DeletionComment" class="text-danger"></span>
		<br />
		<br />
		<input type="submit" value="Delete" class="btn btn-danger" />
		<div>
			@if (Model?.Department == "Business") @* returns to a different list depending on who's being looked at, nullable prevents NREs*@
			{
				<a asp-action="ListOfBusiness">Back to List</a>
			}
			else if (Model?.Department == "IT")
			{
				<a asp-action="ListOfIT">Back to List</a>
			}
			else
			{
				<a asp-action="ListOfUsers">Back to List</a>
			}
		</div>
	</form>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}