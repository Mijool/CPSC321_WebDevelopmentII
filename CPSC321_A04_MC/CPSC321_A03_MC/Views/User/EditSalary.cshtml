@model CPSC321_A04_MC.Models.UserModel

@{
    ViewData["Title"] = "EditSalary";
}

<h1>EditSalary</h1>

<h4>UserModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditSalary">
	        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
	        <div> @*to be able to provide a regex check when we enter our data, we need to secretly submit all existing employee data
				so that the modelState returns valid.
				I do this by hiding the inputs that are preloaded when the view is generated*@
		        <input type="hidden" asp-for="ID" class="form-control" />
		        <input type="hidden" asp-for="FirstName" class="form-control" />
		        <input type="hidden" asp-for="LastName" class="form-control" />
		        <input type="hidden" asp-for="Department" class="form-control" />
		        <input type="hidden" asp-for="Position" class="form-control" />
				<input type="hidden" asp-for="YearsOfExperience" class="form-control" />
	        </div>
			
	        <div class="form-group row">
		        <label asp-for="ID" class="control-label">ID: @Model.ID</label>

		        <label asp-for="FirstName" class="control-label">First Name: @Model.FirstName</label>

		        <label asp-for="LastName" class=" control-label">Last Name: @Model.LastName</label>
	        </div>

            <div class="form-group">
                <label asp-for="Salary" class="control-label"></label>
                <input asp-for="Salary" class="form-control" />
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
	<div>
		@if (Model?.Department == "Business") @* returns to a different list depending on who's being looked at, nullable prevents NREs*@
		{
			<a asp-action="ListOfBusiness">Back to List</a>
		}
		else if (Model?.Department == "IT") 
		{
			<a asp-action="ListOfIT">Back to List</a>
		}
		else
		{
			<a asp-action="ListOfUsers">Back to List</a>
		}
	</div>
</div>
@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

